
:root{
  --bg:#0f1724; /* dark navy */
  --card:#0b1220;
  --accent:#6ee7b7; /* mint */
  --muted:#94a3b8;
  --glass: rgba(255,255,255,0.03);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background: radial-gradient(1000px 600px at 10% 10%, rgba(110,231,183,0.06), transparent),
              radial-gradient(800px 400px at 90% 90%, rgba(99,102,241,0.03), transparent),
              var(--bg);
  color:#e6eef8;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  padding:24px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.container{
  width:100%;
  max-width:900px;
  background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  border-radius:16px;
  box-shadow: 0 8px 30px rgba(2,6,23,0.6);
  padding:24px;
  backdrop-filter: blur(6px);
  border:1px solid rgba(255,255,255,0.03);
}

header{
  display:flex;
  gap:16px;
  align-items:center;
  margin-bottom:18px;
}

.logo{
  width:64px;height:64px;border-radius:12px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--accent), #7c3aed);
  color:#021025;font-weight:700;font-size:14px;
  box-shadow:0 6px 18px rgba(110,231,183,0.06), inset 0 -6px 20px rgba(255,255,255,0.04);
}

h1{font-size:20px;margin:0}
p.lead{margin:0;color:var(--muted);font-size:13px}

.quiz-card{
  display:flex;gap:24px;align-items:flex-start;
}
.main{
  flex:1;background:var(--card);padding:20px;border-radius:12px;border:1px solid var(--glass);
}
.sidebar{
  width:240px;background:transparent;display:flex;flex-direction:column;gap:12px
}

.question-count{font-size:13px;color:var(--muted);margin-bottom:8px}
.question-text{font-size:18px;margin:10px 0 18px}

.choices{display:flex;flex-direction:column;gap:10px}
.choice{
  background:transparent;border:1px solid rgba(255,255,255,0.04);padding:12px;border-radius:10px;cursor:pointer;
  transition:all .18s;display:flex;align-items:center;gap:12px
}
.choice:hover{transform:translateY(-3px);box-shadow:0 8px 18px rgba(2,6,23,0.6)}
.choice input{appearance:none}
.choice.selected{border-color:var(--accent);box-shadow:0 6px 18px rgba(110,231,183,0.06);background:linear-gradient(180deg, rgba(110,231,183,0.02), transparent)}

.controls{display:flex;gap:10px;align-items:center;margin-top:16px}
button{background:none;border:0;padding:10px 14px;border-radius:10px;cursor:pointer;color:inherit}
.btn-primary{background:linear-gradient(90deg,var(--accent), #7c3aed);color:#021025;font-weight:700}
.btn-ghost{border:1px solid rgba(255,255,255,0.04)}

.progress{height:8px;background:rgba(255,255,255,0.03);border-radius:999px;overflow:hidden}
.progress > i{display:block;height:100%;background:linear-gradient(90deg,var(--accent), #7c3aed);width:0%}

.meta{font-size:13px;color:var(--muted);display:flex;justify-content:space-between;align-items:center}
.sidebar .card{background:var(--card);padding:12px;border-radius:10px;border:1px solid var(--glass)}

.qmap{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.qmap button{padding:8px;border-radius:8px}
.qmap button.answered{background:linear-gradient(90deg,var(--accent), #7c3aed);color:#021025}

.result{padding:18px;background:linear-gradient(180deg, rgba(255,255,255,0.02), transparent);border-radius:12px}
footer.note{margin-top:14px;color:var(--muted);font-size:12px}

@media (max-width:880px){
  .quiz-card{flex-direction:column}
  .sidebar{width:100%;order:2}
}
